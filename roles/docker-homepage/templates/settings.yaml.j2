---
title: Homelab
favicon: https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/png/homepage.png

theme: dark
color: slate

headerStyle: clean
statusStyle: dot

hideVersion: true

layout:
{% set hp_services = apps | selectattr('homepage') | list %}
{% set _seen_groups = [] %}
{% set _ordered_groups = [] %}
{% for svc in hp_services %}
{%   if svc.group not in _seen_groups %}
{%     set _ = _seen_groups.append(svc.group) %}
{%     set _ = _ordered_groups.append(svc.group) %}
{%   endif %}
{% endfor %}
{% for grp_name in _ordered_groups %}
{% set grp_settings = homepage_group_settings.get(grp_name, {}) %}
{% set first_svc = hp_services | selectattr('group', 'equalto', grp_name) | first %}
  {{ grp_name }}:
    style: {{ grp_settings.get('icon_style', 'row') }}
    columns: {{ grp_settings.get('columns', 2) }}
    icon: mdi-{{ first_svc.icon }}
{% endfor %}